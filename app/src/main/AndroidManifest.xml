<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".App"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flashlight">

        <!-- MainActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Flashlight"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- QuickSettings Router -->
        <activity
            android:name=".ui.tiles.QsPrefsRouterActivity"
            android:exported="true"
            android:theme="@style/Theme.Flashlight.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity="com.feldman.Flashlight.prefs">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Flashlight Tile -->
        <service
            android:name=".ui.tiles.FlashlightTileService"
            android:label="Flashlight"
            android:icon="@drawable/ic_flashlight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            android:settingsActivity=".FlashlightTile">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.category"
                android:value="CATEGORY_UTILITIES" />
        </service>

        <activity
            android:name=".ui.tiles.FlashlightTile"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:visibleToInstantApps="false"
            android:theme="@style/Theme.Flashlight.Transparent">
        </activity>

        <!-- Full page the tile router opens when "Open full pages" is on -->
        <activity
            android:name=".ui.pages.FlashlightPageActivity"
            android:exported="false"
            android:theme="@style/Theme.Flashlight"
            android:configChanges="orientation|screenSize" />



    </application>

</manifest>
